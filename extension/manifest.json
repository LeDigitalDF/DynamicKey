{
  "manifest_version": 3,
  "name": "DynamicKey",
  "version": "0.9.50",
  "description": "Pairs with the DynamicKey Mac app for rhythm-based login verification and Mail Shield phishing checks on the web.",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    },
    "gecko": {
      "id": "dynamickey@ledigital.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["storage", "alarms", "tabs", "scripting", "webNavigation"],
  "host_permissions": [
    "http://127.0.0.1:17487/*",
    "https://mail.proton.me/*",
    "https://mail.protonmail.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/keystrokeauth-page.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.yahoo.com/*"
      ],
      "js": ["content/mail-shield.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://mail.proton.me/*",
        "https://mail.protonmail.com/*"
      ],
      "js": ["content/mail-shield.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "DynamicKey",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
